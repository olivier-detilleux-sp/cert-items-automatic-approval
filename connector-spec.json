{
    "name": "cert-items-automatic-approval",
    "commands": ["campaign:pre-approve"],
    "sourceConfig": [
        {
            "type": "menu",
            "label": "Configuration",
            "items": [
                {
                    "type": "section",
                    "sectionTitle": "Authentication",
                    "sectionHelpMessage": "Provide a Personal Access Token and the ISC API base URL used to authenticate to Identity Security Cloud.",
                    "items": [
                        {
                            "key": "baseurl",
                            "label": "API Base URL",
                            "type": "text",
                            "required": true,
                            "helpMessage": "Example: https://{tenant}.api.identitynow.com"
                        },
                        {
                            "key": "clientId",
                            "label": "Client ID",
                            "type": "text",
                            "required": true
                        },
                        {
                            "key": "clientSecret",
                            "label": "Client Secret",
                            "type": "secret",
                            "required": true
                        }
                    ]
                },
                {
                    "type": "section",
                    "sectionTitle": "Logging",
                    "sectionHelpMessage": "Control the amount of execution detail returned by the command.",
                    "items": [
                        {
                            "key": "debug",
                            "label": "Enable debug mode",
                            "type": "checkbox",
                            "required": false,
                            "helpMessage": "When enabled, detailed logs are written to a CSV file and execution details are returned. Otherwise, only final totals are returned."
                        }
                    ]
                },
                {
                    "type": "section",
                    "sectionTitle": "Business rules",
                    "sectionHelpMessage": "Choose which business rules may automatically approve certification items.",
                    "items": [
                        {
                            "key": "autoApproveIrrevocableRoles",
                            "label": "Auto-approve non-revocable roles",
                            "type": "checkbox",
                            "required": false,
                            "helpMessage": "Automatically approves pending role items when the role is marked as non-revocable."
                        },
                        {
                            "key": "autoApprovePreviouslyApprovedAccess",
                            "label": "Auto-approve access approved in a previous certification",
                            "type": "checkbox",
                            "required": false,
                            "helpMessage": "Automatically approves recertified access when the same access was approved in the identity's latest signed certification and that certification is within the configured age window."
                        },
                        {
                            "key": "maxPreviousCertificationAgeMonths",
                            "label": "Maximum previous certification age (months)",
                            "type": "number",
                            "required": true,
                            "helpMessage": "Maximum age of the latest signed certification used by the previous-approval rule."
                        }
                    ]
                },
                {
                    "type": "section",
                    "sectionTitle": "AI recommendations",
                    "sectionHelpMessage": "Configure automatic approval based on SailPoint AI recommendations and its interaction with business rules.",
                    "items": [
                        {
                            "key": "autoApproveAiRecommendedAccess",
                            "label": "Auto-approve AI-recommended access",
                            "type": "checkbox",
                            "required": false,
                            "helpMessage": "A YES recommendation may automatically approve an access. A NO recommendation blocks a business-rule approval unless business rules are configured to override it. MAYBE, NOT_FOUND, or no recommendation leaves business rules unchanged."
                        },
                        {
                            "key": "businessRulesOverrideAiNo",
                            "label": "Allow business rules to override an AI NO",
                            "type": "checkbox",
                            "required": false,
                            "helpMessage": "When enabled, an item selected by an active business rule is approved even when SailPoint AI recommends NO."
                        },
                        {
                            "key": "approveAiRecommendedPreviouslyRevoked",
                            "label": "Allow AI approval of previously revoked access",
                            "type": "checkbox",
                            "required": false,
                            "helpMessage": "When enabled, a YES recommendation may approve access that was revoked in the identity's latest signed certification."
                        },
                        {
                            "key": "aiRecommendationBatchSize",
                            "label": "AI recommendation batch size",
                            "type": "number",
                            "required": true,
                            "helpMessage": "Number of identity/access pairs sent in each recommendation API request."
                        }
                    ]
                }
            ]
        }
    ],
    "sourceConfigInitialValues": {
        "debug": false,
        "autoApproveIrrevocableRoles": true,
        "autoApprovePreviouslyApprovedAccess": true,
        "maxPreviousCertificationAgeMonths": 12,
        "autoApproveAiRecommendedAccess": false,
        "businessRulesOverrideAiNo": false,
        "approveAiRecommendedPreviouslyRevoked": false,
        "aiRecommendationBatchSize": 50
    },
    "accountSchema": {
        "displayAttribute": "firstName",
        "identityAttribute": "email",
        "attributes": [
            {
                "name": "firstName",
                "type": "string",
                "description": "First name of the account"
            },
            {
                "name": "lastName",
                "type": "string",
                "description": "Last name of the account"
            },
            {
                "name": "email",
                "type": "string",
                "description": "Email of the account"
            }
        ]
    },
    "entitlementSchemas": []
}
